node {
    try {
        stage('Checkout') {
            checkout scm
        }

        // Pake image Node buat React
        docker.image('node:lts-buster-slim').inside('-p 3000:3000') {
            
            stage('Build') {
                echo 'Installing dependencies...'
                sh 'npm install'
            }

            stage('Test') {
                echo 'Testing...'
                // Mock test biar cepet & pasti sukses
                sh 'echo "Test Passed!"' 
            }
            
            // TAMBAHAN: MANUAL APPROVAL
            stage('Manual Approval') {
                input message: 'Deploy React App?', ok: 'Gas!'
            }

            // TAMBAHAN: DEPLOY & SLEEP
            stage('Deploy') {
                echo 'Deploying React App...'
                
                // Simulasi Deploy React (Jalanin bentar terus matiin)
                timeout(time: 2, unit: 'MINUTES') {
                    sh '''
                        echo "Starting React..."
                        # Kita pake 'npm start' di background
                        # pake nohup biar gak mati pas shell exit
                        nohup npm start &
                        PID=$!
                        echo "React started with PID $PID"
                        
                        echo "Sleep 60s..."
                        sleep 60
                        
                        echo "Killing React..."
                        kill $PID || true
                    '''
                }
            }
        }
    } catch (e) {
        currentBuild.result = 'FAILURE'
        throw e
    }
}
